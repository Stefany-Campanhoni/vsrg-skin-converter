base_sha="$(git rev-parse origin/main)"
head_sha="$(git rev-parse HEAD)"
head_ref="$(git branch --show-current)"
if ! node .ci/quality/assert-pr-changeset.ts "$base_sha" "$head_sha" "$head_ref"; then
  node .ci/quality/git-hook-feedback.ts pre-push-changeset
  exit 1
fi

if ! npm run check; then
  node .ci/quality/git-hook-feedback.ts pre-push-quality
  exit 1
fi
