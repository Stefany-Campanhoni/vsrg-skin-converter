{
  "name": "vsrg-skin-converter",
  "version": "1.0.3",
  "private": true,
  "packageManager": "bun@1.4.0",
  "main": "src/cli.ts",
  "scripts": {
    "build": "bun .ci/release/build-application.ts",
    "build:standalone": "bun .ci/standalone/build-standalone.ts",
    "build:windows": "bun .ci/release/assemble-windows-portable.ts",
    "test:distribution": "bun test tests/distribution --timeout 15000 --max-concurrency 1 && bun .ci/release/create-windows-release.ts",
    "release:windows": "bun run test && bun run typecheck && bun run lint && bun run test:architecture && bunx --bun --no-install tsc --noEmit --noUnusedLocals --noUnusedParameters && bun run build:windows && bun .ci/release/create-windows-release.ts",
    "dev": "bun --watch src/cli.ts",
    "start": "bun src/cli.ts",
    "changeset": "bunx --bun --no-install changeset",
    "changeset:status": "bunx --bun --no-install changeset status",
    "changeset:version": "bunx --bun --no-install changeset version && bun install --lockfile-only",
    "changeset:pre": "bunx --bun --no-install changeset pre",
    "prepare": "bunx --bun --no-install husky",
    "check": "bun run test && bun run typecheck && bun run lint && bun run test:architecture && bunx --bun --no-install tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:staged": "bun run lint && bun run typecheck && git diff --cached --check",
    "typecheck": "bunx --bun --no-install tsc --noEmit",
    "test": "bun test --timeout 15000 --max-concurrency 1",
    "test:architecture": "bun test tests/architecture --timeout 15000 --max-concurrency 1",
    "lint": "bunx --bun --no-install @biomejs/biome check .ci src tests",
    "format": "bunx --bun --no-install @biomejs/biome format --write .ci src tests"
  },
  "keywords": [
    "etterna",
    "osu",
    "osu-mania",
    "skin-converter",
    "vsrg"
  ],
  "author": "tefyy",
  "license": "GPL-3.0-only",
  "description": "Convert VSRG skins between Etterna and osu!mania.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stefany-Campanhoni/vsrg-skin-converter.git"
  },
  "bugs": {
    "url": "https://github.com/Stefany-Campanhoni/vsrg-skin-converter/issues"
  },
  "homepage": "https://github.com/Stefany-Campanhoni/vsrg-skin-converter#readme",
  "type": "module",
  "engines": {
    "bun": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/luaparse": "^0.2.13",
    "@types/bun": "1.4.0",
    "@types/semver": "7.8.0",
    "husky": "9.1.7",
    "semver": "7.8.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "luaparse": "^0.3.1",
    "sharp": "^0.35.3"
  }
}
