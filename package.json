{
  "name": "vsrg-skin-converter",
  "version": "1.0.3",
  "private": true,
  "packageManager": "bun@1.4.0",
  "main": "src/cli.ts",
  "scripts": {
    "build": "node .ci/release/build-application.ts",
    "build:windows": "node .ci/release/assemble-windows-portable.ts",
    "test:distribution": "bun test tests/distribution --timeout 15000 --max-concurrency 1 && node .ci/release/create-windows-release.ts",
    "release:windows": "npm test && npm run typecheck && npm run lint && npm run test:architecture && npx tsc --noEmit --noUnusedLocals --noUnusedParameters && npm run build:windows && node .ci/release/create-windows-release.ts",
    "dev": "node --watch src/cli.ts",
    "start": "node src/cli.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "changeset:pre": "changeset pre",
    "prepare": "husky",
    "check": "npm test && npm run typecheck && npm run lint && npm run test:architecture && npx tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:staged": "npm run lint && npm run typecheck && git diff --cached --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 15000 --max-concurrency 1",
    "test:architecture": "bun test tests/architecture --timeout 15000 --max-concurrency 1",
    "lint": "npx @biomejs/biome check .ci src tests",
    "format": "npx @biomejs/biome format --write .ci src tests"
  },
  "keywords": [
    "etterna",
    "osu",
    "osu-mania",
    "skin-converter",
    "vsrg"
  ],
  "author": "tefyy",
  "license": "GPL-3.0-only",
  "description": "Convert VSRG skins between Etterna and osu!mania.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stefany-Campanhoni/vsrg-skin-converter.git"
  },
  "bugs": {
    "url": "https://github.com/Stefany-Campanhoni/vsrg-skin-converter/issues"
  },
  "homepage": "https://github.com/Stefany-Campanhoni/vsrg-skin-converter#readme",
  "type": "module",
  "engines": {
    "bun": "1.4.0",
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/luaparse": "^0.2.13",
    "@types/bun": "1.4.0",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "semver": "7.8.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "luaparse": "^0.3.1",
    "sharp": "^0.35.3"
  }
}
